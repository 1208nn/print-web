# print-web 配置
# OpenRC 放在 /etc/conf.d/print-web，systemd 放在 /etc/print-web.env

HOST=0.0.0.0
PORT=8080

# 目标 CUPS 队列。留空则使用 lpstat -d 的默认队列。
CUPS_QUEUE=my-printer

# 远端 CUPS（可选）
# CUPS_SERVER=printserver.local:631

# 页面默认选项
# DEFAULT_DUPLEX=long        # off | long | short
# DEFAULT_PAPER=auto         # auto | a4 | letter | legal | a5
# DEFAULT_RESOLUTION=600     # 300 | 600 | 1200

# 限制
MAX_MB=50
QUEUE_MAX=20

# 调试：只走状态机，不调用 lp
# DRY_RUN=1
